# DocuMind Environment Configuration

# Google Gemini API key (required for LLM answering and query rewriting)
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding model (Hugging Face / sentence-transformers, runs locally for free)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Storage paths
DATA_DIR=./data
VECTOR_STORE_PATH=./data/faiss_index

# RAG parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
# Distance threshold for cosine similarity / L2 distance cutoff
SIMILARITY_THRESHOLD=0.35

# Upload restrictions
MAX_UPLOAD_SIZE_MB=10

# Security and CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=60
